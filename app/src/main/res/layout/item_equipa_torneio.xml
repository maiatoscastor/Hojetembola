<?xml version="1.0" encoding="utf-8"?>
<!-- Team accordion item — espelha o .team-item do mockup_08_detalhe_torneio.html -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/screen_padding"
    android:layout_marginEnd="@dimen/screen_padding"
    android:layout_marginTop="6dp"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/bg_border"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Header row (sempre visível) ──────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground">

            <!-- Avatar colorido (cor aplicada em código) -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <View
                    android:id="@+id/vAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvIniciais"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    tools:text="FC" />
            </FrameLayout>

            <!-- Nome + contagem de jogadores -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="FC Malcata" />

                <TextView
                    android:id="@+id/tvNumMembros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="12 jogadores" />
            </LinearLayout>

            <!-- Botão "Ver plantel" (estilo pill) -->
            <TextView
                android:id="@+id/tvChevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:fontFamily="@font/poppins_semi_bold"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:text="›" />
        </LinearLayout>

        <!-- ── Secção expansível: lista de jogadores ─────────────────────── -->
        <LinearLayout
            android:id="@+id/layoutJogadores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="68dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:background="#10224C"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/bg_border"
                android:layout_marginBottom="8dp" />

            <!-- Player rows adicionados programaticamente -->

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
