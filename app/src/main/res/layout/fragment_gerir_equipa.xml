<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- ═══════════════════════════════════════════════════════════════════
         TOOLBAR
    ═══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="20dp"
        android:paddingBottom="@dimen/spacing_md"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/cancelar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_sm"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gerir_jogadores"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvEquipaNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEditarEquipa"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_icon"
            android:contentDescription="@string/editar_equipa"
            android:src="@drawable/ic_edit"
            android:visibility="gone"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnApagarEquipa"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_icon"
            android:contentDescription="@string/apagar_equipa"
            android:src="@drawable/ic_delete"
            android:visibility="gone"
            app:tint="@color/color_live" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════
         HERO CARD — contador de jogadores e limites
    ═══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutContador"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Ícone decorativo "equipa" -->
        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="⚽"
            android:textSize="16sp"
            android:background="@drawable/bg_tag"
            android:layout_marginEnd="10dp" />

        <!-- Contador de jogadores -->
        <TextView
            android:id="@+id/tvContador"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semi_bold"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <!-- Limites min/max (badge pill) -->
        <TextView
            android:id="@+id/tvLimites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════
         PESQUISA DE UTILIZADORES
    ═══════════════════════════════════════════════════════════════════════ -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPesquisa"
        style="@style/Widget.HojeTemBola.TextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginTop="@dimen/spacing_md"
        android:hint="@string/pesquisar_jogador_hint"
        app:layout_constraintTop_toBottomOf="@id/layoutContador"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPesquisa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/text_primary"
            android:inputType="textPersonName"
            android:imeOptions="actionSearch" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Loading da pesquisa (overlay sobre o campo) -->
    <ProgressBar
        android:id="@+id/progressPesquisa"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="22dp"
        android:indeterminateTint="@color/orange"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/tilPesquisa"
        app:layout_constraintBottom_toBottomOf="@id/tilPesquisa"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════════════════
         SECÇÃO: CONVITES PENDENTES
    ═══════════════════════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvLabelConvites"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/convites_pendentes"
        android:textColor="@color/orange"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:textSize="11sp"
        android:fontFamily="@font/poppins_semi_bold"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tilPesquisa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvConvitesPendentes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="@drawable/bg_card"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvLabelConvites"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Espaçador entre convites e membros (controlado pelo Fragment) -->
    <View
        android:id="@+id/dividerConvites"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/rvConvitesPendentes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════════════════
         SECÇÃO: JOGADORES DA EQUIPA
    ═══════════════════════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvLabelMembros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/jogadores_equipa"
        android:textColor="@color/orange"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:textSize="11sp"
        android:fontFamily="@font/poppins_semi_bold"
        app:layout_constraintTop_toBottomOf="@id/dividerConvites"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Loading inicial de membros -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:indeterminateTint="@color/orange"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvLabelMembros"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Lista de membros dentro de card -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMembros"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:background="@drawable/bg_card"
        app:layout_constraintTop_toBottomOf="@id/tvLabelMembros"
        app:layout_constraintBottom_toTopOf="@id/btnInscrever"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════════════════
         BOTÃO INSCREVER (fixo na base)
    ═══════════════════════════════════════════════════════════════════════ -->
    <Button
        android:id="@+id/btnInscrever"
        style="@style/Widget.HojeTemBola.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="24dp"
        android:text="@string/inscrever_equipa"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════════════════
         RESULTADOS DE PESQUISA — overlay flutuante (declarado por último
         para ficar acima de todo o conteúdo — z-order ConstraintLayout)
    ═══════════════════════════════════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvResultadosPesquisa"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="220dp"
        android:background="@drawable/bg_search_dropdown"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tilPesquisa"
        app:layout_constraintStart_toStartOf="@id/tilPesquisa"
        app:layout_constraintEnd_toEndOf="@id/tilPesquisa" />

</androidx.constraintlayout.widget.ConstraintLayout>
