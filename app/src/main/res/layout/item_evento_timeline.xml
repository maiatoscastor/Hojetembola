<?xml version="1.0" encoding="utf-8"?>
<!-- Split-timeline row: one event goes either to the casa (left) or visitante (right) column -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:minHeight="52dp"
    android:layout_marginBottom="4dp">

    <!-- ── Casa side (weight=1) ──────────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layoutEventoCasa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_event_item"
            android:layout_marginEnd="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvMinutoCasa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/orange"
                android:textSize="10sp"
                tools:text="47'" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvIconCasa"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:gravity="start"
                    tools:text="⚽" />

                <TextView
                    android:id="@+id/tvDescricaoCasa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="João M." />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ── Centre separator (continuous vertical bar) ───────────────────── -->
    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="match_parent">

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:background="#1E3260" />
    </FrameLayout>

    <!-- ── Visitante side (weight=1) ─────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layoutEventoVisitante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_event_item"
            android:layout_marginStart="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvMinutoVisitante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/orange"
                android:textSize="10sp"
                tools:text="32'" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvIconVisitante"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:gravity="start"
                    tools:text="🟨" />

                <TextView
                    android:id="@+id/tvDescricaoVisitante"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Pedro S." />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
