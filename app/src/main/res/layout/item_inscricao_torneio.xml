<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Linha principal: avatar + info + badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Avatar circular com iniciais -->
        <TextView
            android:id="@+id/tvIniciais"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins_bold"
            android:textSize="14sp"
            tools:text="FC" />

        <!-- Nome + membros -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="IPVC FC" />

            <TextView
                android:id="@+id/tvMembros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                tools:text="6 jogadores" />

        </LinearLayout>

        <!-- Badge de estado -->
        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:textSize="10sp"
            android:background="@drawable/bg_badge_open"
            tools:text="Pendente"
            tools:textColor="#F57C00" />

    </LinearLayout>

    <!-- Botões de ação (visíveis só quando estado = Pendente ou Confirmada) -->
    <LinearLayout
        android:id="@+id/layoutBotoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginStart="52dp"
        android:visibility="gone"
        tools:visibility="visible">

        <Button
            android:id="@+id/btnAceitar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/aceitar"
            android:fontFamily="@font/poppins_semi_bold"
            android:textSize="11sp"
            android:textColor="@color/green"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnRejeitar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="@string/rejeitar"
            android:fontFamily="@font/poppins_semi_bold"
            android:textSize="11sp"
            android:textColor="@color/color_live" />

    </LinearLayout>

</LinearLayout>
