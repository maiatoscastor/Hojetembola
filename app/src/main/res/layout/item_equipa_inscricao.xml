<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingTop="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_md">

    <!-- Avatar circle -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <View
            android:id="@+id/vAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvIniciais"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/poppins_bold"
            android:textSize="13sp"
            tools:text="SCP" />
    </FrameLayout>

    <!-- Nome + Cidade + Contagem de jogadores -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="@dimen/spacing_sm">

        <TextView
            android:id="@+id/tvNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semi_bold"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Sporting CP" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Lisboa · "
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvNumMembros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                tools:text="👥 5 jogadores" />
        </LinearLayout>
    </LinearLayout>

    <!-- Estado da inscrição -->
    <Button
        android:id="@+id/btnInscrever"
        style="@style/Widget.HojeTemBola.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="80dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="12sp"
        android:text="@string/inscrever_equipa" />

    <TextView
        android:id="@+id/tvJaInscrita"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semi_bold"
        android:textColor="@color/green"
        android:textSize="12sp"
        android:text="@string/ja_inscrita"
        android:visibility="gone" />

</LinearLayout>
