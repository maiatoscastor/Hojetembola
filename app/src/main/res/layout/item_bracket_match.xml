<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/bg_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Team Casa -->
        <LinearLayout
            android:id="@+id/rowCasa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/vCorCasa"
                android:layout_width="10dp"
                android:layout_height="10dp" />

            <TextView
                android:id="@+id/tvNomeCasa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/poppins_semi_bold"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="FC Sporting" />

            <TextView
                android:id="@+id/tvGoloCasa"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:gravity="end"
                tools:text="2" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/bg_border" />

        <!-- Team Visitante -->
        <LinearLayout
            android:id="@+id/rowVisitante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/vCorVisitante"
                android:layout_width="10dp"
                android:layout_height="10dp" />

            <TextView
                android:id="@+id/tvNomeVisitante"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/poppins_semi_bold"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Benfica" />

            <TextView
                android:id="@+id/tvGoloVisitante"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:gravity="end"
                tools:text="1" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
