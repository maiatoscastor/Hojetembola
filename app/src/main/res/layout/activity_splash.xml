<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout portrait do SplashActivity.

    Duas camadas sobrepostas (FrameLayout):
      1. FragmentContainerView — NavHost do fluxo de auth (fundo, invisível durante o splash)
      2. splashOverlay          — Fundo azul escuro com logo + nome + subtítulo + loader
                                  Desaparece com fade-out quando a sessão é verificada.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- ── Camada 1: NavHost do fluxo de auth ──────────────────────────────── -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/auth_nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_auth" />

    <!-- ── Camada 2: Overlay do splash (frente) ────────────────────────────── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary">

        <!-- Logo da app — contentor branco arredondado com a logo real -->
        <FrameLayout
            android:id="@+id/imgLogo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/bg_logo_container"
            android:clipChildren="true"
            android:padding="8dp"
            app:layout_constraintBottom_toTopOf="@id/tvAppName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.36"
            app:layout_constraintVertical_chainStyle="packed">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_logo_app"
                android:scaleType="centerCrop"
                android:src="@drawable/logo_htb" />

        </FrameLayout>

        <!-- Nome da app -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            app:layout_constraintBottom_toTopOf="@id/tvSubtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgLogo" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/app_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            app:layout_constraintBottom_toTopOf="@id/progressLoading"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAppName" />

        <!-- Barra de loading animada (indeterminate, laranja) -->
        <ProgressBar
            android:id="@+id/progressLoading"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="108dp"
            android:layout_height="@dimen/progress_bar_height"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:indeterminate="true"
            android:indeterminateTint="@color/orange"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintVertical_bias="0.12" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
