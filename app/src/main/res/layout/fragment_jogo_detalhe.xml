<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- ── Toolbar ───────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_md"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/cancelar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_sm"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:text="@string/jogo_detalhe" />
    </LinearLayout>

    <!-- ── Divider ───────────────────────────────────────────────────────── -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/bg_border"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── ProgressBar ───────────────────────────────────────────────────── -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/orange"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Content scroll ───────────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ── Score section ─────────────────────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Teams and score row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <!-- Casa -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvAvatarCasa"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:gravity="center"
                                android:fontFamily="@font/poppins_bold"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:layout_gravity="center_horizontal" />

                            <TextView
                                android:id="@+id/tvNomeCasa"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:fontFamily="@font/poppins_semi_bold"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:layout_marginTop="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:fontFamily="@font/poppins_regular"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp"
                                android:text="CASA" />
                        </LinearLayout>

                        <!-- Score -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <TextView
                                android:id="@+id/tvScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:textColor="@color/text_primary"
                                android:textSize="32sp"
                                android:gravity="center"
                                android:text="@string/vs" />

                            <TextView
                                android:id="@+id/tvMinutoAtual"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:textColor="@color/orange"
                                android:textSize="13sp"
                                android:gravity="center"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- Visitante -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvAvatarVisitante"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:gravity="center"
                                android:fontFamily="@font/poppins_bold"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:layout_gravity="center_horizontal" />

                            <TextView
                                android:id="@+id/tvNomeVisitante"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:fontFamily="@font/poppins_semi_bold"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:layout_marginTop="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:fontFamily="@font/poppins_regular"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp"
                                android:text="FORA" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Estado badge row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvEstadoBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Organizer buttons ──────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/layoutBotoesOrganizador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:visibility="gone">

                <!-- Iniciar Jogo (agendado) -->
                <Button
                    android:id="@+id/btnIniciarJogo"
                    style="@style/Widget.HojeTemBola.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginBottom="8dp"
                    android:text="@string/iniciar_jogo"
                    android:visibility="gone" />

                <!-- Golo Casa (ao_vivo) -->
                <Button
                    android:id="@+id/btnGoloCasa"
                    style="@style/Widget.HojeTemBola.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginBottom="8dp"
                    android:text="@string/golo_casa"
                    android:visibility="gone" />

                <!-- Golo Visitante (ao_vivo) -->
                <Button
                    android:id="@+id/btnGoloVisitante"
                    style="@style/Widget.HojeTemBola.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginBottom="8dp"
                    android:text="@string/golo_visitante"
                    android:visibility="gone" />

                <!-- Cartão Amarelo (ao_vivo) -->
                <Button
                    android:id="@+id/btnCartaoAmarelo"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:textColor="@color/text_primary"
                    android:background="@color/bg_surface"
                    android:text="@string/cartao_amarelo"
                    android:visibility="gone" />

                <!-- Cartão Vermelho (ao_vivo) -->
                <Button
                    android:id="@+id/btnCartaoVermelho"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:textColor="@color/text_primary"
                    android:background="@color/bg_surface"
                    android:text="@string/cartao_vermelho"
                    android:visibility="gone" />

                <!-- Substituição (ao_vivo) -->
                <Button
                    android:id="@+id/btnSubstituicao"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:textColor="@color/text_primary"
                    android:background="@color/bg_surface"
                    android:text="@string/substituicao"
                    android:visibility="gone" />

                <!-- Terminar Jogo (ao_vivo) -->
                <Button
                    android:id="@+id/btnTerminarJogo"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:textColor="#CF6679"
                    android:background="@color/bg_surface"
                    android:text="@string/terminar_jogo"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── Events section ────────────────────────────────────────── -->
            <TextView
                android:id="@+id/tvSectionEventos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/orange"
                android:textSize="@dimen/text_label"
                android:textAllCaps="true"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:text="EVENTOS"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEventos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
