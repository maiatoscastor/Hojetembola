<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- ── Toolbar ───────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_md"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/cancelar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_sm"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:text="@string/jogo_detalhe" />
    </LinearLayout>

    <!-- ── Divider ───────────────────────────────────────────────────────── -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/bg_border"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── ProgressBar ───────────────────────────────────────────────────── -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/orange"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Content scroll ───────────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ── Score card (orange border) ───────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginEnd="@dimen/screen_padding"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#F57C00"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <!-- Estado + timer row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:id="@+id/tvEstadoBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag"
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="10sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.08"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp" />

                        <TextView
                            android:id="@+id/tvMinutoAtual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_timer_pill"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="@color/orange"
                            android:textSize="11sp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Teams + score: 3-column layout (name | score | name) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Casa -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvNomeCasa"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:fontFamily="@font/poppins_bold"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:gravity="center" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:fontFamily="@font/poppins_regular"
                                android:textColor="@color/text_muted"
                                android:textSize="9sp"
                                android:textAllCaps="true"
                                android:letterSpacing="0.06"
                                android:text="CASA"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>

                        <!-- Score centre -->
                        <TextView
                            android:id="@+id/tvScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="@color/text_primary"
                            android:textSize="40sp"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/vs" />

                        <!-- Visitante -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvNomeVisitante"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:fontFamily="@font/poppins_bold"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:gravity="center" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:fontFamily="@font/poppins_regular"
                                android:textColor="@color/text_muted"
                                android:textSize="9sp"
                                android:textAllCaps="true"
                                android:letterSpacing="0.06"
                                android:text="FORA"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Organizer buttons ──────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/layoutBotoesOrganizador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <!-- Definir Titulares (shown when agendado) -->
                <Button
                    android:id="@+id/btnDefinirTitulares"
                    style="@style/Widget.HojeTemBola.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginBottom="8dp"
                    android:text="@string/definir_titulares"
                    android:visibility="gone" />

                <!-- Iniciar Jogo (shown when agendado) -->
                <Button
                    android:id="@+id/btnIniciarJogo"
                    style="@style/Widget.HojeTemBola.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="@string/iniciar_jogo"
                    android:visibility="gone" />

                <!-- Registar evento (shown when ao_vivo) -->
                <Button
                    android:id="@+id/btnRegistarEvento"
                    style="@style/Widget.HojeTemBola.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginBottom="8dp"
                    android:text="@string/registar_evento"
                    android:visibility="gone" />

                <!-- Terminar Jogo (shown when ao_vivo) -->
                <Button
                    android:id="@+id/btnTerminarJogo"
                    style="@style/Widget.HojeTemBola.Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="@string/terminar_jogo"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ── Timeline section label ────────────────────────────────── -->
            <TextView
                android:id="@+id/tvFluxoLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginEnd="@dimen/screen_padding"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:text="@string/fluxo_do_jogo"
                android:visibility="gone" />

            <!-- ── Timeline card (always visible once loaded) ────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginEnd="@dimen/screen_padding"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/bg_border"
                app:strokeWidth="1dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <!-- Team name header columns -->
                    <LinearLayout
                        android:id="@+id/layoutEventosHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/tvCasaHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.06"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <!-- Spacer matching centre separator width -->
                        <View
                            android:layout_width="24dp"
                            android:layout_height="1dp" />

                        <TextView
                            android:id="@+id/tvVisitanteHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.06"
                            android:gravity="end"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <!-- Empty state -->
                    <TextView
                        android:id="@+id/tvSemEventos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="24dp"
                        android:paddingBottom="24dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:text="@string/sem_eventos"
                        android:visibility="visible" />

                    <!-- Events RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvEventos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
