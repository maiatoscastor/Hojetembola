<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout principal da app após autenticação.

    Estrutura vertical:
      1. FragmentContainerView  — NavHost do grafo nav_main (ocupa todo o espaço restante)
      2. Divisor                — linha de 1dp para separar visualmente a bottom nav
      3. BottomNavigationView   — 4 tabs: Início / Torneios / Rankings / Perfil
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <!-- Área de conteúdo — cada tab ocupa este espaço -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_main"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_main" />

    <!-- Divisor superior da bottom nav -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bg_border" />

    <!-- Bottom navigation — altura gerida pelo próprio view + insets aplicados em código -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        style="@style/Widget.HojeTemBola.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/nav_bottom" />

</LinearLayout>
