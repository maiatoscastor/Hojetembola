<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="32dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/bg_border"
            android:layout_marginBottom="16dp" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:text="@string/registar_evento"
            android:layout_marginBottom="18dp" />

        <!-- Section label: Tipo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/orange"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:text="@string/tipo_de_evento"
            android:layout_marginBottom="8dp" />

        <!-- Tipo ChipGroup -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="16dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGolo"
                style="@style/Widget.HojeTemBola.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚽ Golo"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAmarelo"
                style="@style/Widget.HojeTemBola.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟨 Amarelo" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVermelho"
                style="@style/Widget.HojeTemBola.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟥 Vermelho" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSubstituicao"
                style="@style/Widget.HojeTemBola.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 Substituição" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Section label: Equipa -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/orange"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:text="@string/equipa_label"
            android:layout_marginBottom="8dp" />

        <!-- Equipa ChipGroup (texts set in code) -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupEquipa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="16dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEquipaCasa"
                style="@style/Widget.HojeTemBola.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Casa" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEquipaVisitante"
                style="@style/Widget.HojeTemBola.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Visitante" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Minuto -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMinuto"
            style="@style/Widget.HojeTemBola.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/minuto_hint"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMinuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Jogador (golo / amarelo / vermelho) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilJogador"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            app:boxBackgroundColor="@color/bg_surface"
            app:boxStrokeColor="@color/bg_border"
            app:boxStrokeWidth="1.5dp"
            app:hintTextColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/jogador_hint"
            android:layout_marginBottom="12dp">

            <AutoCompleteTextView
                android:id="@+id/spinnerJogador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/poppins_regular" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Assistência (golo only, optional) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAssistencia"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            app:boxBackgroundColor="@color/bg_surface"
            app:boxStrokeColor="@color/bg_border"
            app:boxStrokeWidth="1.5dp"
            app:hintTextColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/assistencia_hint"
            android:visibility="gone"
            android:layout_marginBottom="12dp">

            <AutoCompleteTextView
                android:id="@+id/spinnerAssistencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/poppins_regular" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quem sai (substituição only) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilJogadorSai"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            app:boxBackgroundColor="@color/bg_surface"
            app:boxStrokeColor="@color/bg_border"
            app:boxStrokeWidth="1.5dp"
            app:hintTextColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/quem_sai"
            android:visibility="gone"
            android:layout_marginBottom="12dp">

            <AutoCompleteTextView
                android:id="@+id/spinnerJogadorSai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/poppins_regular" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quem entra (substituição only) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilJogadorEntra"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            app:boxBackgroundColor="@color/bg_surface"
            app:boxStrokeColor="@color/bg_border"
            app:boxStrokeWidth="1.5dp"
            app:hintTextColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/quem_entra"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <AutoCompleteTextView
                android:id="@+id/spinnerJogadorEntra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/poppins_regular" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirmar button -->
        <Button
            android:id="@+id/btnConfirmar"
            style="@style/Widget.HojeTemBola.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/confirmar" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
