<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout landscape do SliderFragment.

    Dois painéis side-by-side:
      Esquerda (60%): ViewPager2 com o conteúdo do slide
      Direita  (40%): "Saltar" + dots + botão "Seguinte"
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="horizontal">

    <!-- Painel esquerdo — ViewPager2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3" />

    <!-- Painel direito — controlos de navegação -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/screen_padding">

        <!-- "Saltar introdução" — alinhado ao topo do painel direito -->
        <TextView
            android:id="@+id/btnSaltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="@dimen/spacing_xl"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:minHeight="44dp"
            android:minWidth="44dp"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:text="@string/slider_saltar"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <!-- Dots de progresso -->
        <LinearLayout
            android:id="@+id/dotsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xl"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <!-- Botão "Seguinte" / "Começar" -->
        <Button
            android:id="@+id/btnSeguinte"
            style="@style/Widget.HojeTemBola.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/slider_seguinte" />

    </LinearLayout>

</LinearLayout>
