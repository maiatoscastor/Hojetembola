<?xml version="1.0" encoding="utf-8"?>
<!-- Item de cada slide do onboarding — landscape (ícone à esq, texto à dir) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_xxl"
    android:paddingEnd="@dimen/spacing_xxl">

    <ImageView
        android:id="@+id/imgSlideIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="@dimen/spacing_xl"
        android:contentDescription="" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSlideTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvSlideDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:fontFamily="@font/poppins_regular"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

    </LinearLayout>

</LinearLayout>
