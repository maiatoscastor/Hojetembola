<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base — aplica o design system HojeTemBola ao Material3 -->
    <style name="Base.Theme.HojeTemBola" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Cores primárias -->
        <item name="colorPrimary">@color/orange</item>
        <item name="colorPrimaryVariant">@color/bg_primary</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Cores secundárias -->
        <item name="colorSecondary">@color/green</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Superfícies -->
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_border</item>

        <!-- Fundo -->
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- Status bar transparente -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>

    </style>

    <style name="Theme.HojeTemBola" parent="Base.Theme.HojeTemBola" />

    <!-- ── Splash Theme (sem animação de entrada) ─────────────────────────── -->
    <style name="Theme.HojeTemBola.Splash" parent="Theme.HojeTemBola">
        <item name="android:windowBackground">@color/bg_primary</item>
    </style>

    <!-- ── Estilos de texto ───────────────────────────────────────────────── -->
    <style name="TextAppearance.HojeTemBola.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="fontFamily">@font/poppins_bold</item>
    </style>

    <style name="TextAppearance.HojeTemBola.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_card_title</item>
        <item name="fontFamily">@font/poppins_semi_bold</item>
    </style>

    <style name="TextAppearance.HojeTemBola.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="fontFamily">@font/poppins_regular</item>
    </style>

    <style name="TextAppearance.HojeTemBola.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="fontFamily">@font/poppins_regular</item>
    </style>

    <!-- ── Botão principal (laranja) ─────────────────────────────────────── -->
    <style name="Widget.HojeTemBola.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/orange</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="fontFamily">@font/poppins_semi_bold</item>
    </style>

    <!-- ── Botão secundário (superfície) ─────────────────────────────────── -->
    <style name="Widget.HojeTemBola.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:backgroundTint">@color/bg_surface</item>
        <item name="strokeColor">@color/bg_border</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="cornerRadius">@dimen/button_radius</item>
    </style>

    <!-- ── Campo de texto ────────────────────────────────────────────────── -->
    <style name="Widget.HojeTemBola.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/bg_surface</item>
        <item name="boxStrokeColor">@color/bg_border</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="hintTextColor">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.HojeTemBola.Input</item>
    </style>

    <style name="ShapeAppearance.HojeTemBola.Input" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/input_radius</item>
    </style>

    <!-- ── Tab (login / registo) ────────────────────────────────────────── -->
    <style name="TextAppearance.HojeTemBola.Tab" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/poppins_semi_bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ── Dropdown de seleção (ex: Perfil / Filtros) ───────────────────── -->
    <style name="Widget.HojeTemBola.ExposedDropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/bg_surface</item>
        <item name="boxStrokeColor">@color/bg_border</item>
        <item name="boxStrokeWidth">@dimen/border_width</item>
        <item name="hintTextColor">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.HojeTemBola.Input</item>
        <!-- Sobrepõe o estilo do AutoCompleteTextView interno ANTES do render -->
        <item name="materialThemeOverlay">@style/ThemeOverlay.HojeTemBola.Dropdown</item>
    </style>

    <!-- Theme overlay que força Poppins no AutoCompleteTextView interno -->
    <style name="ThemeOverlay.HojeTemBola.Dropdown" parent="">
        <item name="autoCompleteTextViewStyle">@style/Widget.HojeTemBola.AutoCompleteField</item>
    </style>

    <style name="Widget.HojeTemBola.AutoCompleteField" parent="Widget.AppCompat.AutoCompleteTextView">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
        <!-- Texto centrado dentro do campo -->
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <!-- Remove o underline que vinha do AppCompat EditText -->
        <item name="android:background">@null</item>
        <!-- Fundo escuro no popup de opções -->
        <item name="android:popupBackground">@color/bg_surface</item>
    </style>

    <!-- ── Card ──────────────────────────────────────────────────────────── -->
    <style name="Widget.HojeTemBola.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_surface</item>
        <item name="strokeColor">@color/bg_border</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Filter Chip -->
    <style name="Widget.HojeTemBola.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">11sp</item>
        <item name="chipMinHeight">32dp</item>
    </style>

    <!-- Date Picker overlay — inherits app primary=orange automatically via theme so no extra attrs needed -->
    <style name="ThemeOverlay.HojeTemBola.DatePicker" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
    </style>

    <!-- ── Bottom Navigation ────────────────────────────────────────────── -->
    <style name="Widget.HojeTemBola.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/bg_surface</item>
        <item name="elevation">0dp</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.HojeTemBola.BottomNav.Indicator</item>
        <item name="itemIconSize">22dp</item>
        <item name="android:paddingTop">4dp</item>
    </style>

    <!-- Indicador ativo subtil — mesma cor do fundo, praticamente invisível -->
    <!-- Não pode ser totalmente transparente: o M3 reserva espaço para ele e corta os labels -->
    <style name="Widget.HojeTemBola.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/bg_surface</item>
    </style>

</resources>
