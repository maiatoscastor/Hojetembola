<?xml version="1.0" encoding="utf-8"?>
<!--
    Bola de futebol vetorial para uso interno na app.
    Viewport 100×100. Bola laranja com 6 pentágonos brancos geometricamente corretos.
    Funciona sobre fundos escuros (bg_primary).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Bola laranja, centro (50,50), raio 46 -->
    <path
        android:fillColor="#F57C00"
        android:pathData="M50,4 A46,46 0,1,0 50,96 A46,46 0,1,0 50,4 Z" />

    <!-- Pentágono central (branco) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50.0,38.0 L61.4,46.3 L57.1,59.7 L42.9,59.7 L38.6,46.3 Z" />

    <!-- Pentágono superior-direito -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M61.8,33.8 L58.5,23.8 L67.0,17.5 L75.6,23.8 L72.3,33.8 Z" />

    <!-- Pentágono direito -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M69.0,56.2 L77.6,50.0 L86.1,56.2 L82.9,66.2 L72.3,66.2 Z" />

    <!-- Pentágono inferior -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50.0,70.0 L58.6,76.2 L55.3,86.3 L44.7,86.3 L41.4,76.2 Z" />

    <!-- Pentágono esquerdo -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M31.0,56.2 L27.7,66.2 L17.1,66.2 L13.9,56.2 L22.4,50.0 Z" />

    <!-- Pentágono superior-esquerdo -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38.2,33.8 L27.7,33.8 L24.4,23.8 L33.0,17.5 L41.5,23.8 Z" />

</vector>
